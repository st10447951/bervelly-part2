@model List<Order>
@{ViewData["Title"]="My Orders";}
<div class="page"><h1>My Orders</h1>@if(!Model.Any()){<div class="empty"><p>No orders yet.</p></div>}@foreach(var o in Model){<div class="order card"><div><b>#@o.OrderNumber</b><small>@o.Date.ToString("dd MMM yyyy")</small></div><div><span class="status">@o.Status</span><b>R @o.Total.ToString("0")</b></div><p>@string.Join(", ", o.Items.Select(x=>$"{x.ProductName} ({x.Size}) ×{x.Quantity}"))</p></div>}</div>