@model List<CartItem>
@{ViewData["Title"]="Cart"; var sub=Model.Sum(x=>x.LineTotal); var del=sub>=500?0:80; var total=sub+del;}
<div class="page"><h1>Your Cart</h1>@if(!Model.Any()){<div class="empty"><h2>Your cart is empty</h2><p>Find something you love.</p><a class="btn red" asp-controller="Shop" asp-action="Index">Shop Now</a></div>}else{<div class="cart-grid"><div>@foreach(var i in Model){<div class="cart-item"><img src="~/images/@i.Image"><div class="cart-main"><h3>@i.ProductName</h3><p>Size: @i.Size · Qty: @i.Quantity</p><b>R @i.LineTotal.ToString("0")</b></div><form asp-action="Remove" method="post"><input type="hidden" name="productId" value="@i.ProductId"><input type="hidden" name="size" value="@i.Size"><button class="remove">Remove</button></form></div>}</div><aside class="summary"><h2>Summary</h2><div><span>Subtotal</span><b>R @sub.ToString("0")</b></div><div><span>Delivery</span><b>@(del==0?"FREE":"R "+del.ToString("0"))</b></div><hr><div class="total"><span>Total</span><b>R @total.ToString("0")</b></div><a class="btn red wide" asp-controller="Checkout" asp-action="Index">Proceed to Checkout</a></aside></div>}</div>