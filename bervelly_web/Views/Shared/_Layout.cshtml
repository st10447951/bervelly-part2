<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] — BEVERLLY</title><link rel="stylesheet" href="~/css/site.css"></head>
<body>
<header class="topbar"><a asp-controller="Home" asp-action="Index" class="brand"><img src="~/images/beverlly_logo.png" alt="BEVERLLY"></a>
<nav><a asp-controller="Home" asp-action="Index">Home</a><a asp-controller="Shop" asp-action="Index">Shop</a><a asp-controller="Cart" asp-action="Index">Cart</a><a asp-controller="Cart" asp-action="Wishlist">Wishlist</a><a asp-controller="Orders" asp-action="Index">Orders</a><a asp-controller="Profile" asp-action="Index">Profile</a></nav>
<div class="account">@if(Context.Session.GetInt32("userId").HasValue){<span>Hi, @Context.Session.GetString("userName")</span><a asp-controller="Account" asp-action="Logout">Sign out</a>}else{<a asp-controller="Account" asp-action="Login">Sign in</a>}</div></header>
<main>@RenderBody()</main><footer>© @DateTime.Now.Year BEVERLLY SOUTH AFRICA</footer>
@await RenderSectionAsync("Scripts", required:false)</body></html>