@model CheckoutViewModel
@{ViewData["Title"]="Checkout";}
<div class="page"><a class="back" asp-controller="Cart" asp-action="Index">← Back to cart</a><h1>Checkout</h1><form asp-action="Place" method="post"><div class="checkout-grid"><div class="card"><h2>Delivery Details</h2><label>Delivery Address</label><textarea asp-for="Address" required></textarea><h2>Payment Method</h2><label class="radio"><input type="radio" asp-for="PaymentMethod" value="Card"> Credit / Debit Card</label><label class="radio"><input type="radio" asp-for="PaymentMethod" value="EFT" checked> EFT Bank Transfer</label><label class="radio"><input type="radio" asp-for="PaymentMethod" value="PayFast"> PayFast</label><span asp-validation-for="Address" class="error"></span><button class="btn red wide">Place Order — R @Model.Total.ToString("0")</button></div><aside class="summary"><h2>Order Summary</h2>@foreach(var i in Model.Items){<div class="mini"><span>@i.ProductName<br><small>@i.Size × @i.Quantity</small></span><b>R @i.LineTotal.ToString("0")</b></div>}<hr><div><span>Subtotal</span><b>R @Model.Subtotal.ToString("0")</b></div><div><span>Delivery</span><b>@(Model.Delivery==0?"FREE":"R "+Model.Delivery.ToString("0"))</b></div><div class="total"><span>Total</span><b>R @Model.Total.ToString("0")</b></div></aside></div></form></div>