@model User
@{ViewData["Title"]="Profile";}
<div class="page"><h1>Profile</h1>@if(TempData["Message"]!=null){<div class="success">@TempData["Message"]</div>}<div class="profile-grid"><div class="card"><h2>Account</h2><form asp-action="Update" method="post"><label>First Name</label><input asp-for="FirstName"><label>Last Name</label><input asp-for="LastName"><label>Email</label><input asp-for="Email" readonly><label>Phone</label><input asp-for="Phone"><label>Address</label><textarea asp-for="Address"></textarea><button class="btn red">Save Changes</button></form></div><div class="card menu"><a asp-controller="Orders" asp-action="Index">My Orders →</a><a asp-controller="Cart" asp-action="Wishlist">Wishlist →</a><a asp-controller="Account" asp-action="Logout">Sign Out →</a></div></div></div>