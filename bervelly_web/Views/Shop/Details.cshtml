@model ProductDetailViewModel
@{ViewData["Title"]=Model.Product.Name;}
<div class="page detail"><a class="back" asp-action="Index">← Back to shop</a><div class="detail-grid"><div class="detail-image"><img src="~/images/@Model.Product.Image" alt="@Model.Product.Name"></div><div class="detail-info"><div class="category">@Model.Product.Category.ToUpper()</div><h1>@Model.Product.Name</h1><div class="price">R @Model.Product.Price.ToString("0")</div><p>@Model.Product.Description</p><div class="stock">✓ In Stock (@Model.Product.Stock available)</div>
<form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId" value="@Model.Product.Id"><label>SIZE</label><div class="sizes">@foreach(var s in Model.Product.SizeList){<label><input type="radio" name="size" value="@s" required> <span>@s</span></label>}</div><label>QUANTITY</label><input class="qty" type="number" name="quantity" value="1" min="1" max="@Model.Product.Stock"><button class="btn red wide">Add to Cart — R @Model.Product.Price.ToString("0")</button></form>
<form asp-controller="Cart" asp-action="ToggleWishlist" method="post"><input type="hidden" name="productId" value="@Model.Product.Id"><button class="btn outline wide">@(Model.InWishlist?"♥ Saved to Wishlist":"♡ Save to Wishlist")</button></form></div></div></div>