@model ShopViewModel
@{ViewData["Title"]="Shop";}
<div class="page"><div class="shop-title"><div><div class="eyebrow">COLLECTION</div><h1>Shop</h1></div><span>@Model.Products.Count product@(Model.Products.Count==1?"":"s")</span></div>
<form class="search" method="get"><input name="query" value="@Model.Query" placeholder="Search products…"><input type="hidden" name="category" value="@Model.Category"><button>Search</button></form>
<div class="chips">@foreach(var c in Model.Categories){<a class="chip @(c==Model.Category?"active":"")" asp-route-category="@c" asp-route-query="@Model.Query">@c</a>}</div>
<div class="grid">@foreach(var p in Model.Products){<partial name="_ProductCard" model="p" />}</div></div>