@model RegisterViewModel
@{ViewData["Title"]="Create Account";}
<div class="auth"><img src="~/images/beverlly_logo.png" class="auth-logo"><span class="tag">SOUTH AFRICA</span><div class="card"><h1>Create Account</h1><p>Join BEVERLLY</p><div asp-validation-summary="ModelOnly" class="error"></div><form method="post"><label>First Name</label><input asp-for="FirstName"><label>Last Name</label><input asp-for="LastName"><label>Email Address</label><input asp-for="Email" type="email"><label>Password</label><input asp-for="Password" type="password"><label>Phone Number</label><input asp-for="Phone"><label>Delivery Address</label><textarea asp-for="Address"></textarea><button class="btn red wide">Create Account</button></form><div class="auth-link">Already have an account? <a asp-action="Login">Sign in</a></div></div></div>